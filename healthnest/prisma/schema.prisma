// Healthnestt data model. See ../../CONTENT_MODEL_SPEC.md.
// Runs on Postgres (Supabase). The automated tests derive a throwaway SQLite copy of this file (tests/globalSetup.js).
// Enum-like fields are plain strings, validated in src/lib/constants.js, so the schema stays portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("reader") // admin | freelancer | reader
  status       String    @default("active") // active | deactivated
  bio          String?
  photoUrl     String?
  slug         String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  articles     Article[]     @relation("ArticleAuthor")
  reviewed     Article[]     @relation("ArticleReviewer")
  reviewNotes  ReviewNote[]
  uploads      MediaAsset[]
  bookmarks    Bookmark[]
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String
  position    Int         @default(0)
  isActive    Boolean     @default(true)
  articles    Article[]
  conditions  Condition[]
}

model Condition {
  id         String    @id @default(cuid())
  name       String    @unique
  slug       String    @unique
  overview   String
  isActive   Boolean   @default(true)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  articles   Article[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String    @default("")
  body            String    @default("") // sanitized HTML
  coverImageUrl   String?
  coverImageAlt   String?
  status          String    @default("draft") // draft | submitted | changes_requested | approved | published | archived
  seoTitle        String?
  seoDescription  String?
  canonicalUrl    String?
  readingTimeMin  Int       @default(1)
  isFeatured      Boolean   @default(false)
  featuredRank    Int?
  viewCount       Int       @default(0)
  submittedAt     DateTime?
  publishedAt     DateTime?
  lastReviewedAt  DateTime?
  nextReviewDueAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authorId    String
  author      User       @relation("ArticleAuthor", fields: [authorId], references: [id])
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  conditionId String?
  condition   Condition? @relation(fields: [conditionId], references: [id])
  // Reserved for the future "medically reviewed" badge. Unused in v1.
  reviewerId  String?
  reviewer    User?      @relation("ArticleReviewer", fields: [reviewerId], references: [id])

  tags        ArticleTag[]
  sources     Source[]
  reviewNotes ReviewNote[]
  bookmarks   Bookmark[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([authorId, status])
  @@index([nextReviewDueAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model Source {
  id            String  @id @default(cuid())
  articleId     String
  article       Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title         String
  publisher     String
  url           String
  publishedYear Int?
  position      Int     @default(0)
}

model ReviewNote {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  type      String // changes_requested | approved | comment
  message   String   @default("")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("pending") // pending | confirmed | unsubscribed
  source         String?
  token          String    @unique @default(cuid())
  consentAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String   @unique // random, e.g. 3f2a...c1.jpg. Stored in /uploads and served at /uploads/<filename>
  url          String   @unique
  mimeType     String
  sizeBytes    Int
  originalName String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  body           String
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

model Calculator {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  type        String // bmi | calorie | water | macro | sleep | a1c
  isActive    Boolean @default(true)
}

// Every email the site sends (or, with no provider connected, would send). Visible to admins at /admin/emails.
model EmailLog {
  id         String   @id @default(cuid())
  to         String
  subject    String
  html       String
  text       String
  kind       String // newsletter_confirm | article_submitted | changes_requested | article_approved | article_published | test
  provider   String // log | resend
  status     String // logged | sent | failed
  error      String?
  providerId String?
  createdAt  DateTime @default(now())

  @@index([to, createdAt])
  @@index([createdAt])
}

// A reader's saved article. Deleting the user or the article removes the bookmark.
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
}
